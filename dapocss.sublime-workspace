			"contents": "/*!\n * DAPOCSS v1.1.0\n * A lightweight and modern CSS styling framework designed specifically for KEBENET\n * \n * Built with Sass for better maintainability and scalability\n * Copyright (c) 2025 KEBENET\n * Licensed under MIT\n */\n\n@use \"sass:color\";\n// Make variables and functions available to other files\n// @forward \"sass:color\";\n@use \"sass:map\";\n\n// This function generates `var(--color, fallback-value)`.\n@function theme($name, $level: null) {\n  // Get the base color from the map using the map module.\n  $color: map.get($theme-colors, $name);\n\n  // If a color name is not found, throw an error.\n  @if $color == null {\n    @error \"Color `#{$name}` not found in $theme-colors map.\";\n  }\n\n  // If a tint level is specified...\n  @if $level != null {\n    // Get the alpha value for the tint level using the map module.\n    $alpha: map.get($tints, $level);\n    @if $alpha == null {\n      @error \"Tint level `#{$level}` not found in $tints map.\";\n    }\n    // Construct the variable name and the fallback color with the new alpha.\n    $variable-name: --#{$name}-#{$level};\n    $fallback-color: color.change($color, $alpha: $alpha);\n    @return var(#{$variable-name}, #{$fallback-color});\n  } @else {\n    // Otherwise, use the base color.\n    $variable-name: --#{$name};\n    @return var(#{$variable-name}, #{$color});\n  }\n}\n\n@function varof($name) {\n  @return var(--#{$name}, #{$name});\n}\n\n@function themeof($name) {\n  @return var(--#{$name}, #{$name});\n}\n\n$theme-colors: (\n  \"primary\": hsla(163, 53%, 38%, 1),\n  \"secondary\": hsla(210, 50%, 50%, 1),\n  \"info\": hsla(190, 60%, 65%, 1),\n  \"danger\": hsla(0, 70%, 55%, 1),\n  \"success\": hsla(120, 60%, 45%, 1),\n  \"warning\": hsla(45, 90%, 50%, 1)\n);\n\n\n// This map will be applied to EVERY color in the $theme-colors map.\n$tints: (100: 0.08, 200: 0.2, 300: 0.44, );\n\n\n\n\n// Theme Mixins (Using Generic Variables)\n// =============================================================================\n@mixin default-theme-colors {\n\n\n  --font-family-base: #{$font-family-base};\n  --font-family-mono: #{$font-family-mono};\n\n\n  @each $name, $color in $theme-colors {\n    --#{$name}: #{$color};\n\n    @each $level, $alpha in $tints {\n      $result: #{color.change($color, $alpha: $alpha)};\n      $hex-color: rgb($result);\n      --#{$name}-#{$level}: #{$hex-color};\n    }\n  }\n\n\n  --bg-body: #{$bg-body};\n  --bg-body-200: #{$bg-body-200};\n  --bg-body-300: #{$bg-body-300};\n\n  --text-body: #{$text-body};\n  --text-muted: #{$text-muted};\n\n  // --info-color:theme(\"info\");\n  // --success-color: theme(\"success\");\n  // --warning-color: theme(\"warning\");\n  // --danger-color: theme(\"danger\");\n  // --error-color: theme(\"danger\");\n\n  // Our special dark background Color\n  --renova: hsl(203, 36%, 12%); // #132129;\n\n  --border-color:#{$border-color};\n\n  --text-theme: #{$text-theme};\n  --bg-theme: #{$bg-theme};\n  --block-theme: #{$block-theme};\n\n  --border-color:#{$border-color};\n  \n  --focus-color: #{$focus-color} ;\n  --selection: #{$selection-color};\n  --highlight: #{$highlight-color};\n  --form-text: #{$form-text};\n  --form-placeholder: #{$form-placeholder};\n\n  --button-hover: #{$button-hover};\n  --secondary-hover: #{$secondary-hover};\n  --secondary-focus: #{$secondary-focus};\n\n  --scrollbar-thumb: #{$scrollbar-thumb};\n  --scrollbar-thumb-hover: #{$scrollbar-thumb-hover};\n  --border-radius-base: #{$border-radius-base};\n\n  --hr-width: 100%;\n\n  --spacing-xs: #{$spacing-xs};\n  --spacing-s:  #{$spacing-s};\n  --spacing-m:  #{$spacing-m};\n  --spacing-l:  #{$spacing-l};\n  --spacing-xl: #{$spacing-xl};\n  --spacing-xxl:#{$spacing-xxl};\n\n  --select-arrow: #{$select-arrow};\n  --animation-duration: #{$animation-duration};\n}\n\n\n// Build-time variables (keep as SASS variables)\n// =============================================================================\n$font-family-base: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif;\n$font-family-mono: monospace;\n$line-height-base: 1.4;\n$font-weight-normal: 400;\n$font-weight-bold: 700;\n$max-width: 1100px;\n$breakpoint-large: 1280px;\n\n// Typography Scale Values (for CSS variables)\n// =============================================================================\n$text-s: clamp(0.8rem, 0.25vi + 0.74rem, 0.94rem);\n$text-base: clamp(1rem, 0.45vi + 0.89rem, 1.25rem);\n$text-m: clamp(1.25rem, 0.76vi + 1.06rem, 1.67rem);\n$text-l: clamp(1.56rem, 1.2vi + 1.26rem, 2.22rem);\n$text-xl: clamp(1.95rem, 1.83vi + 1.5rem, 2.96rem);\n$text-xxl: clamp(2.44rem, 2.74vi + 1.76rem, 3.95rem);\n$text-xxxl: clamp(3.05rem, 4.02vi + 2.05rem, 5.26rem);\n\n// Fallback Typography (for browsers without clamp support)\n$text-s-fallback: 0.8rem;\n$text-base-fallback: 1rem;\n$text-m-fallback: 1.25rem;\n$text-l-fallback: 1.56rem;\n$text-xl-fallback: 1.95rem;\n$text-xxl-fallback: 2.44rem;\n$text-xxxl-fallback: 3.05rem;\n\n// Large screen typography\n$text-s-large: 0.94rem;\n$text-base-large: 1.25rem;\n$text-m-large: 1.67rem;\n$text-l-large: 2.22rem;\n$text-xl-large: 2.96rem;\n$text-xxl-large: 3.95rem;\n$text-xxxl-large: 5.26rem;\n\n// Brand Colors (base values)\n// =============================================================================\n// $primary: hsla(163, 53%, 38%, 1);\n\n// $primary-100: hsla(163, 53%, 38%, 0.08);\n// $primary-200: hsla(163, 53%, 38%, 0.20);\n// $primary-300: hsla(163, 53%, 38%, 0.44);\n\n// $secondary: hsla(23, 84%, 73%, 1);\n// $secondary-100: hsla(23, 84%, 73%, 0.08);\n// $secondary-200: hsla(23, 84%, 73%, 0.2);\n// $secondary-300: hsla(23, 84%, 73%, 0.44);\n\n// Default Theme Colors\n// =============================================================================\n\n$bg-body: theme(\"primary\",100);\n$bg-body-200: theme(\"primary\",200);\n$bg-body-300: theme(\"primary\",300);\n\n// =============================================================================\n$text-body: #212121;\n$text-muted: #70777f;\n$default-colored: theme(\"primary\"); // <-- default colorable text|bg ect.. button-bg | a link color\n\n// this variable is for card inside element that can set different bg\n$text-theme: varof($text-body); // <-- flexible theming color\n$bg-theme: theme(\"primary\");    // <-- flexible theming bg\n$block-theme: white;    // <-- default card bg\n\n// Informative Color\n// =============================================================================\n\n// $info-color: #00b0f4;\n// $success-color: #11b76b;\n// $warning-color: #ffa100;\n// $danger-color: red;\n$error-color: theme(\"danger\");\n\n// Default UI Colors\n// =============================================================================\n\n$focus-color: theme(\"primary\", 300);\n$selection-color: theme(\"primary\", 300);\n$highlight-color: theme(\"primary\", 300);\n\n$border-color: theme(\"primary\");\n\n$text-theme: varof($text-body);\n$bg-theme: unset;\n\n\n\n// Default Form Colors\n// =============================================================================\n\n$form-text: #1d1d1d;\n$form-placeholder: #949494;\n\n\n// Default Button Colors\n// =============================================================================\n\n$button-hover: theme(\"primary\",200);\n$secondary-hover: theme(\"secondary\",200);\n$secondary-focus:theme(\"secondary\",300);\n\n\n// Default Scrollbar Colors\n// =============================================================================\n\n$scrollbar-thumb: theme(\"primary\");\n$scrollbar-thumb-hover: theme(\"secondary\");\n\n\n// Spacing variables (CSS variables)\n// =============================================================================\n\n$spacing-xs: 4px;\n$spacing-s: 8px;\n$spacing-m: 16px;\n$spacing-l: 32px;\n$spacing-xl: 78px;\n$spacing-xxl: 120px;\n\n$border-radius-base: 7px;\n$border-radius-small: 2px;\n$border-radius-large: 13px;\n\n// Animation\n// =============================================================================\n$animation-duration: 0.1s;\n$transition-timing: linear;\n$transition-timing-ease: ease;\n\n// Z-index\n// =============================================================================\n$z-index-modal: 1000;\n$z-index-dropdown: 100;\n$z-index-header: 50;\n\n// Default SVG Icons\n// =============================================================================\n\n$select-arrow: url(\"data:image/svg+xml;charset=utf-8,%3C?xml version='1.0' encoding='utf-8'?%3E %3Csvg version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' height='62.5' width='116.9' fill='%23161f27'%3E %3Cpath d='M115.3,1.6 C113.7,0 111.1,0 109.5,1.6 L58.5,52.7 L7.4,1.6 C5.8,0 3.2,0 1.6,1.6 C0,3.2 0,5.8 1.6,7.4 L55.5,61.3 C56.3,62.1 57.3,62.5 58.4,62.5 C59.4,62.5 60.5,62.1 61.3,61.3 L115.2,7.4 C116.9,5.8 116.9,3.2 115.3,1.6Z'/%3E %3C/svg%3E\");\n\n$dialog-backdrop: #0000009c;\n$shadow-dark: #000;\n$shadow-light: #0d0d0d;\n$range-border: #010101;\n$transparent: transparent;\n\n",
